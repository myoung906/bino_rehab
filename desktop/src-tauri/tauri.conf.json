{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Binocular Vision Rehab",
  "version": "1.0.0",
  "identifier": "com.binorehab.desktop",
  "build": {
    "frontendDist": "/Users/jmseo/Documents/workspace/bino_rehab/web/out",
    "beforeDevCommand": "cd ../web && npm run dev",
    "beforeBuildCommand": "cd ../web && BUILD_TARGET=standalone npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Binocular Vision Rehab",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
